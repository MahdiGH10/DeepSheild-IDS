FLASK_SECRET_KEY=replace_with_strong_secret
FLASK_DEBUG=0
IDS_HOST=0.0.0.0
IDS_PORT=5000
DATABASE_URL=sqlite:///deepshield.db
MODEL_DIR=../NewApprochmodels
OPENROUTER_API_KEY=replace_with_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
IDS_LLM_TIMEOUT_SECONDS=30
IDS_N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/deepshield-report
IDS_N8N_WEBHOOK_SECRET=replace_with_hmac_secret
IDS_N8N_MAX_RETRIES=3
IDS_N8N_RETRY_BACKOFF_SECONDS=2
IDS_N8N_TIMEOUT_SECONDS=20

# Auto-escalation policy (Critical OR repeated High)
IDS_AUTO_ESCALATE_REPEATED_HIGH=1
IDS_REPEATED_HIGH_THRESHOLD=3
IDS_REPEATED_HIGH_WINDOW_SECONDS=120

# Auto-dispatch behavior on escalation (n8n-ready; safe even if webhook is not configured)
IDS_AUTO_DISPATCH_ON_ESCALATION=1
IDS_AUTO_DISPATCH_FORMAT=html
# HTML auto-dispatch: short email body + HTML/PDF/log attachments for n8n (1=on)
IDS_EMAIL_DISPATCH_SHORT_BODY_WITH_ATTACHMENTS=1
# Append full report JSON to the .log attachment (off by default — use HTML/PDF for full detail)
IDS_DISPATCH_LOG_INCLUDE_FULL_JSON=0
IDS_AUTO_DISPATCH_INCLUDE_TIMELINE=1
IDS_AUTO_DISPATCH_INCLUDE_INTERPRETATION=1

# Auto-mail anti-spam controls (applies to auto-dispatch after escalation)
IDS_AUTO_MAIL_COOLDOWN_SECONDS=600
IDS_AUTO_MAIL_MAX_PER_WINDOW=1
IDS_AUTO_MAIL_WINDOW_SECONDS=900

# At most one auto-email per attack_type in this window (stops simulator / flood spam). Set to 0 to disable.
IDS_AUTO_MAIL_GLOBAL_ATTACK_TYPE_LIMIT=1
IDS_AUTO_MAIL_GLOBAL_ATTACK_TYPE_COOLDOWN_SECONDS=600

# Unidentified attack handling (critical escalation + telemetry logs in report)
IDS_UNIDENTIFIED_LOG_WINDOW_MINUTES=15
